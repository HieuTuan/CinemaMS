{
  "info": {
    "name": "CinemaAI Phase 8 - Promotion, Wishlist, Loyalty, Notification",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    { "key": "baseUrl",      "value": "http://localhost:8080" },
    { "key": "accessToken",  "value": "" },
    { "key": "refreshToken", "value": "" },
    { "key": "promotionId",  "value": "1" },
    { "key": "bookingId",    "value": "1" },
    { "key": "movieId",      "value": "1" },
    { "key": "userId",       "value": "1" },
    { "key": "notifId",      "value": "1" }
  ],
  "item": [
    {
      "name": "=== PROMOTION — Admin CRUD ===",
      "item": [
        {
          "name": "01 - Admin Create Promotion (Code-Based)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"code\": \"SUMMER2026\",\n  \"name\": \"Summer Sale 2026\",\n  \"type\": \"PERCENTAGE\",\n  \"value\": 15,\n  \"minOrderAmount\": 100000,\n  \"maxDiscountAmount\": 50000,\n  \"usageLimit\": 100,\n  \"startsAt\": \"2026-06-01T00:00:00\",\n  \"endsAt\": \"2026-09-30T23:59:59\",\n  \"canCombineWithPoints\": true,\n  \"description\": \"Giảm 15% tối đa 50k cho đơn từ 100k\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/admin/promotions",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "admin", "promotions"]
            }
          }
        },
        {
          "name": "02 - Admin Create Point-Redemption Promotion",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"code\": \"POINTS500\",\n  \"name\": \"Đổi 500 điểm lấy 50k\",\n  \"type\": \"FIXED_AMOUNT\",\n  \"value\": 50000,\n  \"minOrderAmount\": 150000,\n  \"usageLimit\": 200,\n  \"startsAt\": \"2026-06-01T00:00:00\",\n  \"endsAt\": \"2026-12-31T23:59:59\",\n  \"canCombineWithPoints\": false,\n  \"requiredPoints\": 500,\n  \"description\": \"Dùng 500 điểm tích lũy để giảm 50.000đ\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/admin/promotions/point-based",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "admin", "promotions", "point-based"]
            }
          }
        },
        {
          "name": "03 - Admin Update Promotion",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Summer Sale Updated\",\n  \"value\": 20,\n  \"minOrderAmount\": 150000,\n  \"maxDiscountAmount\": 60000,\n  \"usageLimit\": 150,\n  \"endsAt\": \"2026-10-05T23:59:59\",\n  \"status\": \"ACTIVE\",\n  \"canCombineWithPoints\": true,\n  \"description\": \"Cập nhật: giảm 20% tối đa 60k\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/admin/promotions/{{promotionId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "admin", "promotions", "{{promotionId}}"]
            }
          }
        },
        {
          "name": "04 - Admin Delete Promotion",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/admin/promotions/{{promotionId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "admin", "promotions", "{{promotionId}}"]
            }
          }
        },
        {
          "name": "05 - Admin List Promotions",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/admin/promotions?page=0&size=20",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "admin", "promotions"],
              "query": [
                { "key": "page", "value": "0" },
                { "key": "size", "value": "20" }
              ]
            }
          }
        },
        {
          "name": "06 - Admin Get Promotion By Code",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/admin/promotions/SUMMER2026",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "admin", "promotions", "SUMMER2026"]
            }
          }
        },
        {
          "name": "07 - Admin Get Promotion Rules",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/admin/promotions/{{promotionId}}/rules",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "admin", "promotions", "{{promotionId}}", "rules"]
            }
          }
        }
      ]
    },
    {
      "name": "=== PROMOTION — Customer ===",
      "item": [
        {
          "name": "08 - Get Promotion By Code",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/promotions/SUMMER2026",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "promotions", "SUMMER2026"]
            }
          }
        },
        {
          "name": "09 - Get Available Promotions",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/promotions/available",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "promotions", "available"]
            }
          }
        },
        {
          "name": "10 - Get Point-Based Promotions",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/promotions/point-based",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "promotions", "point-based"]
            }
          }
        },
        {
          "name": "11 - Validate Promotion (Legacy)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"code\": \"SUMMER2026\",\n  \"orderAmount\": 200000\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/promotions/validate",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "promotions", "validate"]
            }
          }
        },
        {
          "name": "12 - Validate Advanced (Code-Based)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"code\": \"SUMMER2026\",\n  \"orderAmount\": 200000\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/promotions/validate-advanced",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "promotions", "validate-advanced"]
            }
          }
        },
        {
          "name": "13 - Validate Advanced (Point-Based)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"promotionId\": 2,\n  \"orderAmount\": 200000,\n  \"usePoints\": 500\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/promotions/validate-advanced",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "promotions", "validate-advanced"]
            }
          }
        },
        {
          "name": "14 - Validate Advanced + Combination Check",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"code\": \"SUMMER2026\",\n  \"orderAmount\": 300000,\n  \"otherPromotionId\": 2\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/promotions/validate-advanced",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "promotions", "validate-advanced"]
            }
          }
        },
        {
          "name": "15 - Check Combination Compatibility",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"promotionId1\": 1,\n  \"promotionId2\": 2\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/promotions/check-combination",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "promotions", "check-combination"]
            }
          }
        },
        {
          "name": "16 - Apply Promotion To Booking (Code-Based)",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/promotions/apply?bookingId={{bookingId}}&code=SUMMER2026",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "promotions", "apply"],
              "query": [
                { "key": "bookingId", "value": "{{bookingId}}" },
                { "key": "code",      "value": "SUMMER2026" }
              ]
            }
          }
        },
        {
          "name": "17 - Apply Point-Based Promotion To Booking",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/promotions/apply-points?bookingId={{bookingId}}&promotionId=2&pointsToUse=500",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "promotions", "apply-points"],
              "query": [
                { "key": "bookingId",    "value": "{{bookingId}}" },
                { "key": "promotionId",  "value": "2" },
                { "key": "pointsToUse",  "value": "500" }
              ]
            }
          }
        },
        {
          "name": "18 - Remove Promotion From Booking",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/promotions/remove?bookingId={{bookingId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "promotions", "remove"],
              "query": [
                { "key": "bookingId", "value": "{{bookingId}}" }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "=== WISHLIST ===",
      "item": [
        {
          "name": "19 - Add Movie To Wishlist",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"movieId\": {{movieId}}\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/wishlist",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "wishlist"]
            }
          }
        },
        {
          "name": "20 - Get My Wishlist",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/wishlist",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "wishlist"]
            }
          }
        },
        {
          "name": "21 - Remove Movie From Wishlist",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/wishlist/{{movieId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "wishlist", "{{movieId}}"]
            }
          }
        }
      ]
    },
    {
      "name": "=== LOYALTY ===",
      "item": [
        {
          "name": "22 - Get My Loyalty Points",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/loyalty/me",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "loyalty", "me"]
            }
          }
        },
        {
          "name": "23 - Admin Add Loyalty Points",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": {{userId}},\n  \"points\": 100,\n  \"reason\": \"Welcome bonus\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/admin/loyalty/add",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "admin", "loyalty", "add"]
            }
          }
        },
        {
          "name": "24 - Admin Redeem Loyalty Points",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/admin/loyalty/{{userId}}/redeem?points=50",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "admin", "loyalty", "{{userId}}", "redeem"],
              "query": [
                { "key": "points", "value": "50" }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "=== NOTIFICATION ===",
      "item": [
        {
          "name": "25 - Admin Create Notification",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": {{userId}},\n  \"title\": \"Phim mới sắp chiếu\",\n  \"message\": \"Avatar 3 mở bán vé từ 01/07/2026, đặt chỗ ngay!\",\n  \"type\": \"SHOWTIME\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/notifications",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "notifications"]
            }
          }
        },
        {
          "name": "26 - Get My Notifications",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/notifications/me",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "notifications", "me"]
            }
          }
        },
        {
          "name": "27 - Get My Unread Notifications",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/notifications/me/unread",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "notifications", "me", "unread"]
            }
          }
        },
        {
          "name": "28 - Mark Notification As Read",
          "request": {
            "method": "PATCH",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/notifications/{{notifId}}/read",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "notifications", "{{notifId}}", "read"]
            }
          }
        }
      ]
    }
  ]
}
